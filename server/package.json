{
  "name": "expense-tracker-inbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute expense-tracker-inbox --local --file=./schema.sql",
